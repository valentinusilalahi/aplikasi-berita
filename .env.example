# Backend Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sinodal-db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-256-bits-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# File Upload
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=52428800
FILE_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,txt

# Server
SERVER_PORT=8080

# Frontend
VITE_API_URL=http://localhost:8080/api
